# Copy to .env to override defaults. Nothing here is required to run locally.
# Never commit .env.

# Product data source
PRODUCT_API_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# The 5 products the owner has chosen as "top rated" for the home page (Fake Store IDs, in display order)
FEATURED_PRODUCT_IDS=1,5,9,13,17

# Where enquiries are sent
SALES_INBOX=sales@example.com
MAIL_FROM="Catalogue <no-reply@example.com>"

# SMTP settings. Docker Compose points these at Mailpit automatically.
# For production, use a real provider such as Amazon SES SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Only used when running the API outside Docker
PORT=3000
CORS_ORIGIN=http://localhost:5173
